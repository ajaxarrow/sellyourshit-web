SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-password
TICKET_RECEIVER_EMAIL=support-inbox@example.com

# Linked from the nav's "Dev" item and the site footer credit.
DEV_URL=https://your-portfolio.example

# Download counter (Upstash Redis, REST API) — https://console.upstash.com
# Optional: without these, /api/download still works, the counter just
# stays hidden on the homepage instead of tracking anything.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token
